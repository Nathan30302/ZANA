# Device / pilot builds
#
# Point Flutter apps at your hosted API (not localhost):
#   export API_URL="https://YOUR_HOST/v1"
#
# Local LAN testing against your Mac (Android emulator often uses 10.0.2.2):
#   export API_URL="http://10.0.2.2:3000/v1"
# Physical phone on same Wi‑Fi:
#   export API_URL="http://192.168.x.x:3000/v1"
#
# Then:
#   ./scripts/build-internal.sh
#
# Or run once:
#   cd apps/customer && flutter run --dart-define=API_URL="$API_URL"

API_URL=https://YOUR_HOST/v1
