generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROFESSIONAL
  ADMIN
}

enum ProStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProType {
  INDEPENDENT
  SHOP
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum LocationType {
  AT_HOME
  AT_SHOP
}

enum FloatTxnType {
  TOP_UP
  COMMISSION
  ADJUSTMENT
  REFUND
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?
  name      String?
  role      Role     @default(CUSTOMER)
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional ProfessionalProfile?
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  favorites     Favorite[]
  reviewsGiven  Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  notesAboutCustomers CustomerNote[] @relation("ProNotes")
  floatTxns     FloatTransaction[]
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model ProfessionalProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  type            ProType   @default(INDEPENDENT)
  status          ProStatus @default(PENDING)
  verified        Boolean   @default(false)
  bio             String?
  category        String    @default("Barber")
  coverUrl        String?
  lat             Float?
  lng             Float?
  area            String?
  address         String?
  homeService     Boolean   @default(true)
  travelFeeZmw    Int       @default(50)
  floatBalanceZmw Int       @default(0)
  ratingAvg       Float     @default(0)
  ratingCount     Int       @default(0)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  services   Service[]
  portfolio  PortfolioPhoto[]
  documents  ApplicationDocument[]
  hours      WorkingHour[]
  bookings   Booking[] @relation("ProBookings")
  notes      CustomerNote[]
}

model Service {
  id           String   @id @default(cuid())
  professionalId String
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name         String
  category     String
  durationMin  Int
  priceZmw     Int
  homeEligible Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  bookings Booking[]
}

model PortfolioPhoto {
  id             String   @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  url            String
  caption        String?
  createdAt      DateTime @default(now())
}

model ApplicationDocument {
  id             String   @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  kind           String
  url            String
  createdAt      DateTime @default(now())
}

model WorkingHour {
  id             String @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startMin       Int
  endMin         Int
  enabled        Boolean @default(true)

  @@unique([professionalId, dayOfWeek])
}

model Booking {
  id             String        @id @default(cuid())
  customerId     String
  customer       User          @relation("CustomerBookings", fields: [customerId], references: [id])
  professionalId String
  professional   ProfessionalProfile @relation("ProBookings", fields: [professionalId], references: [id])
  serviceId      String
  service        Service       @relation(fields: [serviceId], references: [id])
  status         BookingStatus @default(REQUESTED)
  locationType   LocationType  @default(AT_SHOP)
  address        String?
  scheduledAt    DateTime
  servicePriceZmw Int
  travelFeeZmw   Int           @default(0)
  commissionZmw  Int           @default(0)
  customerNote   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  review Review?

  @@index([customerId, status])
  @@index([professionalId, scheduledAt])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Favorite {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId String
  createdAt      DateTime @default(now())

  @@unique([userId, professionalId])
}

model CustomerNote {
  id             String @id @default(cuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  customerId     String
  customer       User   @relation("ProNotes", fields: [customerId], references: [id], onDelete: Cascade)
  note           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([professionalId, customerId])
}

model FloatTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FloatTxnType
  amountZmw Int
  balanceAfter Int
  note      String?
  bookingId String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model PlatformSettings {
  id                   Int @id @default(1)
  commissionPercent    Float @default(12)
  homeCommissionPercent Float @default(10)
  minFloatZmw          Int @default(50)
  updatedAt            DateTime @updatedAt
}
