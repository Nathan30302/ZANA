PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zana?schema=public"
# Required for real deploys. Auth sessions are JWT (30d). Local fallback is insecure.
JWT_SECRET="change-me-in-production"
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"
PUBLIC_BASE_URL="http://localhost:3000"

# OTP — default is in-memory/dev (OTP_DEV_CODE). Set africas_talking for SMS.
OTP_PROVIDER="dev"
OTP_DEV_CODE="123456"
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=ZANA

# Payments — stub by default. Set PAYMENT_PROVIDER=mobile_money (or MoMo/Airtel keys) for live.
PAYMENT_PROVIDER="stub"
PAYMENT_SIMULATE="true"
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=
# MOMO_ENV=sandbox
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_ENV=sandbox

# FCM — legacy server key enables real push; otherwise logs only
# FIREBASE_SERVER_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# Maps (Flutter/client) — OSM works without a key; set for Google Maps later
# GOOGLE_MAPS_API_KEY=
