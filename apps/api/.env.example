PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zana?schema=public"
JWT_SECRET="change-me-in-production"
CORS_ORIGINS="http://localhost:3001,http://localhost:8081"
PUBLIC_BASE_URL="http://localhost:3000"

# OTP — default is in-memory/dev. Set africas_talking for SMS.
OTP_PROVIDER="dev"
OTP_DEV_CODE="123456"
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=ZANA

# Payments — Stub MoMo/Airtel. PAYMENT_SIMULATE=false leaves purchases PENDING until webhook.
PAYMENT_SIMULATE="true"
# MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER=
# MOMO_API_KEY=
# MOMO_ENV=sandbox
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=
# AIRTEL_ENV=sandbox

# FCM — without these, pushes are logged only
# FIREBASE_SERVER_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=

# Maps (Flutter/client) — OSM works without a key; set for Google Maps later
# GOOGLE_MAPS_API_KEY=
