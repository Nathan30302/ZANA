{
  "name": "zana",
  "private": true,
  "version": "0.1.0",
  "description": "Zana — Beauty on your fingertips. Zambia beauty marketplace.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/web",
    "db:seed": "npm run db:seed -w apps/web",
    "db:reset": "npm run db:reset -w apps/web",
    "db:up": "docker compose up -d"
  },
  "engines": {
    "node": ">=20"
  }
}
